<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8">
<title>ACCESS TERMINAL</title>
<style>
body{
    margin:0;
    height:100vh;
    background:black;
    color:#00ff66;
    font-family:"Courier New", monospace;
    display:flex;
    align-items:center;
    justify-content:center;
    overflow:hidden;
}

/* Dezente CRT-Scanlines */
body::before {
    content:"";
    position:fixed;
    top:0;
    left:0;
    width:100%;
    height:100%;
    background:
      repeating-linear-gradient(
        to bottom,
        rgba(0,255,102,0.05) 0px,
        rgba(0,255,102,0.05) 2px,
        transparent 2px,
        transparent 4px
      );
    pointer-events:none;
    z-index:0;
    animation: scanline 0.5s linear infinite;
}
@keyframes scanline { 0% { background-position:0 0; } 100% { background-position:0 100%; } }

/* Terminal Box mit Pulsieren */
.terminal{
    border:2px solid #00ff66;
    padding:40px;
    width:400px;
    text-align:center;
    box-shadow:0 0 20px #00ff66;
    background:rgba(0,0,0,.9);
    position: relative;
    z-index:1;
    animation: pulse 2s infinite alternate;
}
@keyframes pulse { 0% { box-shadow:0 0 15px #00ff66;} 100% {box-shadow:0 0 25px #00ff66;} }

h3{
    font-size:20px;
    letter-spacing:3px;
    text-shadow:0 0 10px #00ff66;
    margin-bottom:20px;
}
.type{
    margin-bottom:20px;
    font-size:14px;
    opacity:0.8;
}
input{
    width:100%;
    padding:10px;
    background:black;
    border:2px solid #00ff66;
    color:#00ff66;
    font-family:inherit;
    font-size:16px;
    outline:none;
    box-shadow:0 0 10px #00ff66 inset;
}
input.error{
    border:2px solid red;
    box-shadow:0 0 15px red inset,0 0 15px red;
    color:red;
}
button{
    margin-top:20px;
    padding:10px 30px;
    background:black;
    color:#00ff66;
    border:2px solid #00ff66;
    font-family:inherit;
    cursor:pointer;
    box-shadow:0 0 10px #00ff66;
    transition:0.1s;
}
button:hover{
    background:#00ff66;
    color:black;
    box-shadow:0 0 20px #00ff66;
}
.message{
    margin-top:20px;
    font-size:14px;
    min-height:20px;
}
.hidden{display:none;}
.glitch{
    animation:flicker 0.15s infinite alternate;
}
@keyframes flicker{
    from{opacity:1;} to{opacity:0.7;}
}

/* HINWEISE */
.hint {
    font-size:12px;
    color:#00ff66;
    opacity:0.6;
    margin-top:10px;
    border-top:1px dotted #00ff66;
    padding-top:5px;
    font-style:italic;
    animation: hintFlicker 2s infinite;
}
@keyframes hintFlicker {
    0%, 100% { opacity:0.6; }
    50% { opacity:0.8; }
}

/* LEVEL 2 CODE DISPLAY */
#codeDisplay{
    width:100%;
    padding:10px;
    background:black;
    border:2px solid #00ff66;
    color:#00ff66;
    font-family:"Courier New", monospace;
    font-size:20px;
    text-align:center;
    box-shadow:0 0 10px #00ff66 inset;
    margin-bottom:15px;
}

/* LEVEL 2 KEYPAD */
.keypad{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:10px;
    margin-top:10px;
}
.keypad button{
    font-family:"Courier New", monospace;
    font-size:20px;
    padding:15px;
}
.keypad button:hover{
    background:#00ff66;
    color:black;
    box-shadow:0 0 20px #00ff66;
}

/* LEVEL 3 INPUT */
#puzzleInput{
    width:100%;
    padding:10px;
    background:black;
    border:2px solid #00ff66;
    color:#00ff66;
    font-family:"Courier New", monospace;
    font-size:16px;
    outline:none;
    box-shadow:0 0 10px #00ff66 inset;
}

/* COUNTDOWN BLINK */
#countdown {
    font-family:"Courier New", monospace;
    color:#00ff66;
    text-shadow:0 0 10px #00ff66;
    animation: blink 1s step-start infinite;
}
@keyframes blink { 50% { opacity:0.5; } }
</style>
</head>
<body>
<div class="terminal">

<!-- LEVEL 1 -->
<div id="level1">
    <h3 class="glitch">ACCESS TERMINAL</h3>
    <div class="type">[ SYSTEM LOCKED — PASSWORD REQUIRED ]</div>
    <input type="password" id="pw" placeholder="ENTER PASSWORD" oninput="playKeypress()">
    <button onclick="checkPassword()">CONNECT</button>
    <div class="message" id="msg1"></div>
    <div class="hint" id="hint1">Hinweis: Ich bringe dir Freude, doch in meiner Gier liegt dein Untergang</div>
</div>

<!-- LEVEL 2 -->
<div id="level2" class="hidden">
    <h3 class="glitch">SECURITY LOCK</h3>
    <div class="type">[ ENTER NUMERIC CODE ]</div>
    <input type="text" id="codeDisplay" readonly>
    <div class="keypad">
        <button onclick="addNum(1)">1</button>
        <button onclick="addNum(2)">2</button>
        <button onclick="addNum(3)">3</button>
        <button onclick="addNum(4)">4</button>
        <button onclick="addNum(5)">5</button>
        <button onclick="addNum(6)">6</button>
        <button onclick="addNum(7)">7</button>
        <button onclick="addNum(8)">8</button>
        <button onclick="addNum(9)">9</button>
        <button onclick="delNum()">DEL</button>
        <button onclick="addNum(0)">0</button>
        <button onclick="checkCode()">ENTER</button>
    </div>
    <div class="message" id="msg2"></div>
    <div class="hint" id="hint2">Hinweis: Manchmal möchte ich zurück in die Zukunft.</div>
</div>

<!-- LEVEL 3 -->
<div id="level3" class="hidden">
    <h3 class="glitch">TERMINAL PUZZLE</h3>
    <div class="type">[ FIND THE PASSWORD ]</div>
    <div class="type" style="font-size:14px; margin-bottom:15px;">
        Notizzettel gefunden: <br>
        <i>"(51.4213112, -0.4289067)"</i>
    </div>
    <input type="text" id="puzzleInput" placeholder="ENTER PASSWORD" oninput="playKeypress()">
    <button onclick="checkPuzzle()">CONNECT</button>
    <button onclick="backToStart()" style="margin-top:10px;">← ZURÜCK</button>
    <div class="message" id="msg3"></div>
    <div class="hint" id="hint3">Hinweis: Nutze deine digitale Landkarte</div>
    <div class="type" id="countdown" style="margin-top:10px;"></div>
</div>

</div>

<!-- SOUNDS -->
<audio id="keypress" src="keypress.wav"></audio>
<audio id="success" src="success.mp3"></audio>
<audio id="wrong" src="wrong.wav"></audio>
<audio id="background" src="backgroun.mp3" loop></audio>

<script>
const correctPassword = "geld";
const correctCode = "2015";
const puzzlePassword = "Cottage";
let currentCode = "";

const keypress = document.getElementById("keypress");
const success = document.getElementById("success");
const wrong = document.getElementById("wrong");
const background = document.getElementById("background");
background.volume = 0.2;

function playKeypress(){
    keypress.currentTime = 0;
    keypress.play();
}

// Hintergrundmusik nach erster Interaktion
function startBackgroundSound(){
    background.play().catch(()=>{});
    document.removeEventListener('click', startBackgroundSound);
    document.removeEventListener('keydown', startBackgroundSound);
}
document.addEventListener('click', startBackgroundSound);
document.addEventListener('keydown', startBackgroundSound);

// LEVEL 1
function checkPassword(){
    const pw = document.getElementById("pw");
    const msg = document.getElementById("msg1");

    if(pw.value === correctPassword){
        pw.classList.remove("error");
        msg.style.color = "#00ff66";
        msg.innerHTML="[ ACCESS GRANTED ]";
        success.play();
        setTimeout(()=>{
            document.getElementById("level1").classList.add("hidden");
            document.getElementById("level2").classList.remove("hidden");
        },1000);
    }else{
        pw.classList.add("error");
        msg.style.color = "red";
        msg.innerHTML="[ ACCESS DENIED ]";
        wrong.play();
        pw.value="";
    }
}

// LEVEL 2
function addNum(n){
    if(currentCode.length < 6){
        currentCode += n;
        document.getElementById("codeDisplay").value = currentCode;
        playKeypress();
    }
}
function delNum(){
    currentCode = currentCode.slice(0,-1);
    document.getElementById("codeDisplay").value = currentCode;
    playKeypress();
}
function checkCode(){
    const msg = document.getElementById("msg2");
    if(currentCode === correctCode){
        msg.style.color = "#00ff66";
        msg.innerHTML="[ CODE ACCEPTED ]<br>LEVEL COMPLETED...";
        success.play();
        setTimeout(goToLevel3, 1000);
    }else{
        msg.style.color = "red";
        msg.innerHTML="[ WRONG CODE ]";
        wrong.play();
        currentCode="";
        document.getElementById("codeDisplay").value="";
    }
}
function goToLevel3(){
    document.getElementById("level2").classList.add("hidden");
    document.getElementById("level3").classList.remove("hidden");
}

// LEVEL 3
function checkPuzzle(){
    const input = document.getElementById("puzzleInput");
    const msg = document.getElementById("msg3");
    const countdown = document.getElementById("countdown");

    if(input.value === puzzlePassword){
        input.classList.remove("error");
        msg.style.color="#00ff66";
        msg.innerHTML="[ ACCESS GRANTED ]<br>PUZZLE SOLVED!";
        success.play();

        const targetDate = new Date("2026-01-17T00:00:00");
        function updateCountdown(){
            const now = new Date();
            let diff = targetDate - now;

            if(diff <= 0){
                countdown.innerHTML = "[ NEXT PUZZLE AVAILABLE ]";
                clearInterval(timerInterval);
            } else {
                const days = Math.floor(diff / (1000*60*60*24));
                const hours = Math.floor((diff % (1000*60*60*24)) / (1000*60*60));
                const minutes = Math.floor((diff % (1000*60*60)) / (1000*60));
                const seconds = Math.floor((diff % (1000*60)) / 1000);
                countdown.innerHTML = `[ NEXT PUZZLE IN ${days}d ${hours}h ${minutes}m ${seconds}s ]`;
            }
        }
        updateCountdown();
        const timerInterval = setInterval(updateCountdown, 1000);

    } else {
        input.classList.add("error");
        msg.style.color="red";
        msg.innerHTML="[ ACCESS DENIED ]";
        wrong.play();
        input.value="";
    }
}

// ZURÜCK-BUTTON
function backToStart(){
    document.getElementById("level3").classList.add("hidden");
    document.getElementById("level1").classList.remove("hidden");
    document.getElementById("msg3").innerHTML = "";
    document.getElementById("puzzleInput").value = "";
    document.getElementById("countdown").innerHTML = "";
}
</script>
</body>
</html>